FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField {
    // #includeEtc "caseDicts/setConstraintTypes"

    upperWall       {type   totalPressure; p0   uniform 0;}
    inletUpperWall  {type   totalPressure; p0   uniform 0;}
    inlet           {
        // type   zeroGradient;
        type   fixedValue; value   uniform 610;
    }

    lowerWall       {type   totalPressure; p0   uniform 700;}
    // lowerWall       {type   fixedValue; value   uniform 0;}

    outlet          {type   zeroGradient;}
    "bead.*"        {type   zeroGradient;}
    sideWalls       {type   zeroGradient;}
    defaultFaces    {type   empty;}
}


